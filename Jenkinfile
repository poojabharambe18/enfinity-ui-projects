pipeline {
    agent { label 'jenkins-agent1' }

    tools {
        nodejs 'node20'
    }

    environment {
        GIT_REPO_URL = 'https://github.com/poojabharambe18/enfinity-ui-projects.git'
        BRANCH       = 'master'
    }

    stages {
        stage('Cleanup Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout') {
            steps {
                git branch: "${env.BRANCH}",
                    url: "${env.GIT_REPO_URL}"
            }
        }

        stage('SonarQube Scan') {
            steps {
                script {
                    // Get sonar-scanner path from Jenkins tool config
                    def scannerHome = tool name: 'sonarqube-token', type: 'hudson.plugins.sonar.SonarRunnerInstallation'
                    
                    withSonarQubeEnv('sonarqube-token') {
                        sh """
                            ${scannerHome}/bin/sonar-scanner \\
                              -Dsonar.projectKey=frontend-profile \\
                              -Dsonar.sources=. \\
                              -Dsonar.exclusions=**/node_modules/**,**/*.spec.ts \\
                              -Dsonar.host.url=http://10.14.1.49:9000 \\
                              -Dsonar.token=sqp_05341675b56c3f5b904c2563b78b1886413dde93 \\
                              -Dsonar.sourceEncoding=UTF-8
                        """
                    }
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install --legacy-peer-deps'
            }
        }

        stage('Build Frontend') {
            steps {
                sh 'npm run build'
            }
        }
    }

    post {
        success {
            echo 'Frontend pipeline completed successfully.'
        }
        failure {
            echo 'Frontend pipeline failed.'
        }
    }
}
